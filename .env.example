DATABASE_URL=db_url

EMBEDDING_SIZE=1536
EMBEDDING_MODEL_NAME="gemini-embedding-001"

GEMINI_API_KEY=""
GEMINI_MODEL_NAME=""
GEMINI_MAX_RETRIES=1
GEMINI_TIMEOUT_SECONDS=60

# Local backup model (Ollama) - used automatically when Gemini fails
# setup: install ollama, then `ollama pull qwen3.5:4b`
LOCAL_LLM_ENABLED=true
LOCAL_LLM_MODEL_NAME="qwen3.5:4b"
OLLAMA_BASE_URL="http://localhost:11434"
LOCAL_LLM_NUM_CTX=16384
LOCAL_LLM_TIMEOUT_SECONDS=300

# RAG hybrid search
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_CANDIDATES_K=20
RAG_RRF_K=60
RAG_MAX_FILE_SIZE_MB=10

LANGSMITH_TRACING=true
LANGSMITH_API_KEY="ls"
LANGSMITH_PROJECT="sales-agent"
